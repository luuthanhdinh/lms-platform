{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Keycloak": {
    "Authority": "",
    "Audience": "lms-api"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:5173"]
  },
  "RateLimit": {
    "Enabled": true,
    "PerTenantPerMinute": 600,
    "AnonymousPerMinute": 60,
    "WindowSeconds": 60
  },
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/identity/{**rest}" },
        "Transforms": [
          { "RequestHeaderRemove": "X-User-Id" },
          { "RequestHeaderRemove": "X-Tenant-Id" },
          { "RequestHeaderRemove": "X-Roles" },
          { "RequestHeaderRemove": "Authorization" }
        ]
      },
      "courses": {
        "ClusterId": "courses",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/courses/{**rest}" },
        "Transforms": [
          { "RequestHeaderRemove": "X-User-Id" },
          { "RequestHeaderRemove": "X-Tenant-Id" },
          { "RequestHeaderRemove": "X-Roles" },
          { "RequestHeaderRemove": "Authorization" }
        ]
      },
      "content": {
        "ClusterId": "content",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/content/{**rest}" },
        "Transforms": [
          { "RequestHeaderRemove": "X-User-Id" },
          { "RequestHeaderRemove": "X-Tenant-Id" },
          { "RequestHeaderRemove": "X-Roles" },
          { "RequestHeaderRemove": "Authorization" }
        ]
      },
      "enrollment": {
        "ClusterId": "enrollment",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/enrollments/{**rest}" },
        "Transforms": [
          { "RequestHeaderRemove": "X-User-Id" },
          { "RequestHeaderRemove": "X-Tenant-Id" },
          { "RequestHeaderRemove": "X-Roles" },
          { "RequestHeaderRemove": "Authorization" }
        ]
      },
      "progress": {
        "ClusterId": "progress",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/progress/{**rest}" },
        "Transforms": [
          { "RequestHeaderRemove": "X-User-Id" },
          { "RequestHeaderRemove": "X-Tenant-Id" },
          { "RequestHeaderRemove": "X-Roles" },
          { "RequestHeaderRemove": "Authorization" }
        ]
      },
      "assessment": {
        "ClusterId": "assessment",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/assessments/{**rest}" },
        "Transforms": [
          { "RequestHeaderRemove": "X-User-Id" },
          { "RequestHeaderRemove": "X-Tenant-Id" },
          { "RequestHeaderRemove": "X-Roles" },
          { "RequestHeaderRemove": "Authorization" }
        ]
      },
      "certificate": {
        "ClusterId": "certificate",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/certificates/{**rest}" },
        "Transforms": [
          { "RequestHeaderRemove": "X-User-Id" },
          { "RequestHeaderRemove": "X-Tenant-Id" },
          { "RequestHeaderRemove": "X-Roles" },
          { "RequestHeaderRemove": "Authorization" }
        ]
      },
      "verify": {
        "ClusterId": "certificate",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/verify/{**rest}" },
        "Transforms": [
          { "RequestHeaderRemove": "X-User-Id" },
          { "RequestHeaderRemove": "X-Tenant-Id" },
          { "RequestHeaderRemove": "X-Roles" },
          { "RequestHeaderRemove": "Authorization" }
        ]
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "d1": { "Address": "http://identity" }
        }
      },
      "courses": {
        "Destinations": {
          "d1": { "Address": "http://courses" }
        }
      },
      "content": {
        "Destinations": {
          "d1": { "Address": "http://content" }
        }
      },
      "enrollment": {
        "Destinations": {
          "d1": { "Address": "http://enrollment" }
        }
      },
      "progress": {
        "Destinations": {
          "d1": { "Address": "http://progress" }
        }
      },
      "assessment": {
        "Destinations": {
          "d1": { "Address": "http://assessment" }
        }
      },
      "certificate": {
        "Destinations": {
          "d1": { "Address": "http://certificate" }
        }
      }
    }
  }
}

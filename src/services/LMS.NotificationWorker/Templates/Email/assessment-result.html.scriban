<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Assessment Result</title>
</head>
<body style="font-family: Arial, sans-serif; background-color: #f4f4f4; margin: 0; padding: 0;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background-color: #f4f4f4; padding: 20px 0;">
    <tr>
      <td align="center">
        <table width="600" cellpadding="0" cellspacing="0" style="background-color: #ffffff; border-radius: 8px; overflow: hidden;">
          <tr>
            <td style="background-color: {{ passed ? "#16a34a" : "#dc2626" }}; padding: 32px 40px; text-align: center;">
              <h1 style="color: #ffffff; margin: 0; font-size: 24px;">Assessment Result</h1>
            </td>
          </tr>
          <tr>
            <td style="padding: 40px;">
              <h2 style="color: #1f2937; margin: 0 0 8px 0; font-size: 20px;">{{ assessment_name }}</h2>
              <div style="text-align: center; padding: 24px 0;">
                <div style="display: inline-block; background-color: {{ passed ? "#dcfce7" : "#fee2e2" }}; border-radius: 50%; width: 100px; height: 100px; line-height: 100px; text-align: center; margin: 0 auto;">
                  <span style="font-size: 28px; font-weight: bold; color: {{ passed ? "#16a34a" : "#dc2626" }};">{{ score }}%</span>
                </div>
              </div>
              <p style="text-align: center; margin: 0 0 16px 0;">
                <span style="display: inline-block; padding: 6px 16px; border-radius: 9999px; font-size: 14px; font-weight: bold; background-color: {{ passed ? "#16a34a" : "#dc2626" }}; color: #ffffff;">
                  {{ passed ? "PASSED" : "FAILED" }}
                </span>
              </p>
              {{ if !passed && retake_url != null }}
              <p style="color: #4b5563; font-size: 16px; line-height: 1.5; margin: 0 0 24px 0; text-align: center;">
                Don't give up! Review the material and try again.
              </p>
              <table cellpadding="0" cellspacing="0" style="margin: 0 auto;">
                <tr>
                  <td style="background-color: #2563eb; border-radius: 6px;">
                    <a href="{{ retake_url }}" style="display: inline-block; padding: 14px 28px; color: #ffffff; text-decoration: none; font-size: 16px; font-weight: bold;">Retake Assessment</a>
                  </td>
                </tr>
              </table>
              {{ end }}
            </td>
          </tr>
          <tr>
            <td style="background-color: #f9fafb; padding: 24px 40px; text-align: center;">
              <p style="color: #9ca3af; font-size: 14px; margin: 0;">
                {{ passed ? "Congratulations on passing!" : "Keep practicing — you can do it!" }}
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>

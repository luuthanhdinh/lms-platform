<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>lms-notification-worker</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.StackExchange.Redis" Version="9.*" />
    <PackageReference Include="MassTransit.RabbitMQ" Version="8.*" />
    <PackageReference Include="MailKit" Version="4.*" />
    <PackageReference Include="Scriban" Version="5.*" />
    <PackageReference Include="Polly" Version="8.*" />
    <PackageReference Include="Microsoft.FeatureManagement" Version="4.*" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="9.*" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Templates/Email/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../LMS.Contracts/LMS.Contracts.csproj" />
    <ProjectReference Include="../../LMS.ServiceDefaults/LMS.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>

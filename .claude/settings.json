{
  "model": "claude-sonnet-4-6",
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(dotnet:*)",
      "Bash(pnpm:*)",
      "Bash(npm:*)",
      "Bash(python .claude/orchestrate.py)",
      "Bash(bash .claude/skills/backend-dev/check-patterns.sh:*)",
      "Read(**)",
      "Write(src/**)",
      "Write(frontend/**)",
      "Write(tests/**)",
      "Write(docs/**)",
      "Write(.claude/contracts.md)",
      "Write(.claude/task-graph.json)",
      "Write(.claude/review-report.md)",
      "Write(.claude-worktrees/**)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Write(.env*)",
      "Write(.claude/settings.json)",
      "Write(.claude/CLAUDE.md)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -d frontend ]; then (cd frontend && pnpm lint --fix 2>/dev/null) || true; fi"
          }
        ]
      }
    ]
  }
}

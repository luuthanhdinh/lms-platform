{
  "model": "claude-sonnet-4-6",
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet ef migrations:*)",
      "Bash(dotnet ef database update:*)",
      "Bash(dotnet ef dbcontext:*)",
      "Bash(dotnet run:*)",
      "Bash(dotnet new:*)",
      "Bash(dotnet sln:*)",
      "Bash(dotnet add:*)",
      "Bash(dotnet remove:*)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet format:*)",
      "Bash(dotnet user-secrets:*)",
      "Bash(pnpm:*)",
      "Bash(npm:*)",
      "Bash(python .claude/orchestrate.py)",
      "Bash(bash .claude/skills/backend-dev/check-patterns.sh:*)",
      "Bash(bash .claude/skills/tenant-isolation/audit.sh:*)",
      "Read(**)",
      "Write(src/**)",
      "Write(frontend/**)",
      "Write(tests/**)",
      "Write(docs/**)",
      "Write(.claude/contracts.md)",
      "Write(.claude/task-graph.json)",
      "Write(.claude/review-report.md)",
      "Write(.claude/security-report.md)",
      "Write(.claude/tenant-audit.md)",
      "Write(.claude/run-summary.json)",
      "Write(.claude-worktrees/**)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(dotnet ef database drop:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Write(.env*)",
      "Write(**/appsettings.Production.json)",
      "Write(.claude/settings.json)",
      "Write(.claude/CLAUDE.md)",
      "Write(.claude/agents/**)",
      "Write(.claude/skills/**)",
      "Write(.claude/commands/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write(frontend/**)",
        "hooks": [
          { "type": "command",
            "command": "(cd frontend && pnpm lint --fix 2>/dev/null) || true" }
        ]
      },
      {
        "matcher": "Write(src/**)",
        "hooks": [
          { "type": "command",
            "command": "dotnet format --include $CLAUDE_TOOL_FILE_PATH 2>/dev/null || true" }
        ]
      }
    ]
  }
}
